# Portainer stack environment — copy keys into Portainer → Stack → Environment variables
# Do not commit real secrets.

# --- Bắt buộc ---
APP_URL=https://tournament.example.com
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# --- Stack app + postgres (docker-compose.portainer.yaml) ---
POSTGRES_USER=tournament
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=tournament_manager
APP_PORT=3000
TM_IMAGE_TAG=latest
TZ=Asia/Ho_Chi_Minh

# --- Stack external DB (docker-compose.portainer.external-db.yaml) ---
# DATABASE_URL=postgresql://tournament:tournament@192.168.0.17:5432/tournament_manager

# --- Tuỳ chọn ---
RUN_SEED_ON_START=false
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
SEED_ADMIN_DISPLAY_NAME=Admin
DB_WAIT_MAX_ATTEMPTS=30
