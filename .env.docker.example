# Copy to .env when using Docker dev stack (make up / docker-compose-dev.yaml):
#   cp .env.docker.example .env
#   make setup
#
# Docker dev = Next.js HMR (port 3000). Không chạy pnpm build trong container.
# Tests: make test  (vitest trên host, SQLite temp files)

# App
APP_URL=http://localhost:3000
APP_PORT=3000

# SQLite (volume tm_data → /app/data trong container)
DATABASE_URL=/app/data/tournament-manager.db

# Auth
SESSION_SECRET=dev-only-change-me-to-a-long-random-string

# Seed (local/dev only)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_DISPLAY_NAME=Local Admin
RUN_SEED_ON_START=false
