# Copy to .env when using Docker dev stack (make up / docker-compose-dev.yaml):
#   cp .env.docker.example .env
#   make setup
#
# PostgreSQL chạy trên máy LAN (không trong compose).
# Docker container kết nối qua IP 192.168.0.17.

APP_URL=http://localhost:3000
APP_PORT=3000

DATABASE_URL=postgresql://tournament:tournament@192.168.0.17:5432/tournament_manager
TEST_DATABASE_URL=postgresql://tournament:tournament@192.168.0.17:5432/tournament_manager_test

SESSION_SECRET=dev-only-change-me-to-a-long-random-string

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_DISPLAY_NAME=Local Admin
RUN_SEED_ON_START=false
