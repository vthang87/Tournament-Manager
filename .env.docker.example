# Copy to .env when using Docker dev stack (make up / docker-compose-dev.yaml):
#   cp .env.docker.example .env
#   make setup
#
# Docker dev = Next.js HMR (port 3000). Không chạy pnpm build trong container.
# Tests: make test  (vitest trên host, DB tournament_manager_test)

# App
APP_URL=http://localhost:3000
APP_PORT=3000

# PostgreSQL (service tm_postgres trong compose)
POSTGRES_USER=tournament
POSTGRES_PASSWORD=tournament
POSTGRES_DB=tournament_manager
POSTGRES_TEST_DB=tournament_manager_test
FORWARD_DB_PORT=5432

DATABASE_URL=postgresql://tournament:tournament@tm_postgres:5432/tournament_manager
TEST_DATABASE_URL=postgresql://tournament:tournament@localhost:5432/tournament_manager_test

# Auth
SESSION_SECRET=dev-only-change-me-to-a-long-random-string

# Seed (local/dev only)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_DISPLAY_NAME=Local Admin
RUN_SEED_ON_START=false
