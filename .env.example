# Local environment — copy to .env and adjust as needed.
# Never commit the real .env file.

# Absolute or relative path to the SQLite database file.
# Local default: ./data/tournament-manager.db
# Docker: /data/tournament-manager.db
DATABASE_URL=./data/tournament-manager.db

# App URL (used by health checks / links in later tasks)
APP_URL=http://localhost:3000

# Signed session cookie secret (min 32 characters). Generate a unique value per environment.
SESSION_SECRET=dev-only-change-me-to-a-long-random-string

# Seed admin credentials (local/dev only)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_DISPLAY_NAME=Local Admin
