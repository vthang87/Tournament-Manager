
# Copy to docker-compose-dev.local.yaml (gitignored) and customize:
#   cp docker-compose-dev.local.yaml.example docker-compose-dev.local.yaml

services:
  tm_app:
    build:
      context: .
      dockerfile: docker/dev/Dockerfile
    image: tournament_manager:dev
    env_file:
      - .env
    networks:
      - tm
    volumes:
      - .:/app
      - tm_node_modules:/app/node_modules
    ports:
      - "${APP_PORT:-3001}:3000"
    environment:
      NODE_ENV: development
      HOSTNAME: 0.0.0.0
      PORT: "3000"
      DATABASE_URL: ${DATABASE_URL:-postgresql://tournament:tournament@192.168.0.17:5432/tournament_manager}
      APP_URL: ${APP_URL:-http://localhost:3001}
      SESSION_SECRET: ${SESSION_SECRET:-dev-only-change-me-to-a-long-random-string}
      WATCHPACK_POLLING: "true"
      CHOKIDAR_USEPOLLING: "true"

networks:
  tm:
    driver: bridge

volumes:
  tm_node_modules:
    driver: local
